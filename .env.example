# =============================================================================
# VPN Automation Configuration
# Copy this file to .env and customize before running setup_host.sh
# =============================================================================

# --- General ---
NODE_NAME="ting-vvip-server(SG)"
ADMIN_PORT=2053
ADMIN_USER="admin"
ADMIN_PASS="ChangeMe123!"

# --- Verified Shadowsocks (Outline Compatible) ---
SS_ENABLED=true
SS_PORT=25762
SS_CIPHER="chacha20-ietf-poly1305"
# Leave blank or "auto-generate" to auto-generate a secure password
SS_PASSWORD="auto-generate"

# --- VLESS Reality (DPI Resilient) ---
REALITY_ENABLED=true
REALITY_PORT=443
REALITY_SNI="gateway.icloud.com"
# Leave blank to auto-generate via xray x25519
REALITY_PRIVATE_KEY=""
REALITY_PUBLIC_KEY=""

# --- Network & GCP (optional, used by deploy_gcp.sh) ---
GCP_TIER="STANDARD"           # STANDARD ($0.085/GB) or PREMIUM ($0.12/GB)
GCP_REGION="asia-southeast1"  # Singapore (optimal for Myanmar)
GCP_ZONE="asia-southeast1-b"
GCP_PROJECT=""                # Your GCP project ID (leave blank to auto-detect)
GCP_VM_NAME="vpn-node-01"
GCP_MACHINE_TYPE="e2-small"
